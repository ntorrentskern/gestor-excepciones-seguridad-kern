# Copia este archivo a .env (o usa .env.example, es el mismo contenido):
#   cp env.example .env
#   # Windows PowerShell: Copy-Item env.example .env
#
# App (Docker Compose)
# En compose, el host del Postgres es el nombre del servicio: "postgres"
DATABASE_URL=postgresql://gestor:gestor@postgres:5432/gestor_excepciones

# Postgres del compose
POSTGRES_USER=gestor
POSTGRES_PASSWORD=gestor
POSTGRES_DB=gestor_excepciones
POSTGRES_PORT=5432
APP_PORT=3000

# Cookies Secure (ges_session). false = HTTP en intranet (p. ej. http://10.13.0.44).
# Pon true solo si sirves la app por HTTPS.
SECURE_COOKIES=false

# Secreto de firma de sesión (mín. 16 caracteres)
AUTH_SECRET=cambia-este-secreto-en-produccion

# Desarrollo en el host apuntando al Postgres del compose (localhost):
# DATABASE_URL=postgresql://gestor:gestor@localhost:5432/gestor_excepciones

# Neon (solo para volcar datos hacia el Postgres local):
# NEON_DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
